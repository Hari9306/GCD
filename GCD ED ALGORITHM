#include <bits/stdc++.h>
using namespace std;

int main() {
	// brute force idea for gcd 
	int a,b;
	cin>>a>>b;
	int ans=0;
	for(int i=1;i<min(a,b);i++){
	    if(a%i==0&&b%i==0){
	        ans=i;
	    }
	}
	cout<<ans;
	//time complexity-> O(min(a,b));


    //far better solution is
	int a,b;
	cin>>a>>b;
	int ans=0;
	for(int i=min(a,b);i>=1;i--){
	    if(a%i==0&&b%i==0){
	        ans=i;
	        break
	    }
	}
	cout<<ans;
  // time complexity-> O(min(a,b)) may be some iteration may save 
  
  
 
  // Euclidean algorithm
  	int a,b;
	cin>>a>>b;
	while(a>0&&b>0){
	    if(a>b) a=a%b;
	    else b=b%a;
	}
	if(a==0) cout<<b;
	else cout<<a;
  //time complexity->O(log(min(a,b)));
  
}
